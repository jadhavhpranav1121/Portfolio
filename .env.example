# Firebase web app config — Project settings → Your apps → Web app → SDK setup.
# These values are public by design (they identify the project, they do not
# grant access); write access is enforced by Firebase Auth + firestore.rules.
# Copy this file to .env.local for local dev, and set the same values in your
# deploy/build environment so the exported site can reach Firestore.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=fir-91088.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=fir-91088
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=fir-91088.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
