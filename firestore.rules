rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public site content: anyone can read it (the portfolio renders it), only
    // the owner's signed-in Firebase Auth account can write it.
    match /site/content {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'pranavhj23@gmail.com'
                   && request.auth.token.email_verified == true;
    }

    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
